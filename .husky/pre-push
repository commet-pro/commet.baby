#!/usr/bin/env sh

# =============================================================
# PRE-PUSH HOOK — Commet Baby
# =============================================================
# Este hook roda ANTES de cada push e garante:
#   1. Type-check passa (se configurado)
#   2. Bloqueia push de branches com nomes inválidos
# =============================================================

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Validar nome da branch
VALID_BRANCH_REGEX="^(main|develop|feature\/[a-z0-9._-]+|fix\/[a-z0-9._-]+|hotfix\/[a-z0-9._-]+|release\/[a-z0-9._-]+)$"

if ! echo "$BRANCH" | grep -qE "$VALID_BRANCH_REGEX"; then
  echo ""
  echo "🚫 BLOQUEADO: Nome de branch inválido: '$BRANCH'"
  echo ""
  echo "   Use um dos padrões:"
  echo "   • feature/<modulo>-<descricao>  (ex: feature/auth-login)"
  echo "   • fix/<modulo>-<descricao>      (ex: fix/billing-webhook)"
  echo "   • hotfix/<descricao>            (ex: hotfix/login-crash)"
  echo "   • release/<versao>              (ex: release/1.0.0)"
  echo ""
  exit 1
fi

echo "✅ Branch '$BRANCH' validada. Pushing..."
